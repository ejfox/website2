# Node environment
NODE_ENV=production

# Server configuration
DEBUG=false
DEBUG_CONTENT=false

# API Keys and Tokens - Server Only
GITHUB_TOKEN=your_github_personal_access_token
CHESS_USERNAME=your_chess_com_username
RESCUETIME_TOKEN=your_rescuetime_api_key
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_SHARED_SECRET=your_lastfm_shared_secret
WEBMENTION_IO_TOKEN=your_webmention_io_token
MONKEYTYPE_TOKEN=your_monkeytype_api_token
OPENAI_API_KEY=your_openai_api_key
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Umami Analytics
UMAMI_USERNAME=admin
UMAMI_PASSWORD=your_umami_password

# Cal.com webhook signing secret (verifies POSTs to /api/webhooks/calcom)
CALCOM_WEBHOOK_SECRET=your_calcom_webhook_signing_secret


# Bookmarklet Authentication (used by Enhanced Pinboard bookmarklet)
SCRAP_ENLIGHTENER_AUTH=your_secure_bookmarklet_passphrase

# Supabase (for scraps/scrapbook)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Cloudinary — image hosting. Read by the /photos + /api/photo-exif routes AND
# by the authoring tools (yarn capture, yarn shoot, the og-image pipeline,
# sync-alt-to-cloudinary). Without these, `yarn shoot` can't upload.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AT-Proto / Bluesky mirror (scripts/author/mirror-to-atproto.mjs, run by the
# Mirror to AT-Proto workflow on every push to main).
ATPROTO_HANDLE=you.bsky.social
ATPROTO_APP_PASSWORD=your_atproto_app_password

# Obsidian vault paths. Both default to a hardcoded path for EJ's machine, so
# these are only needed on a different machine.
#   OBSIDIAN_VAULT_PATH  — yarn seal:import (sealed posts)
#   DISPATCH_VAULT_PATH  — the og-image extractor
OBSIDIAN_VAULT_PATH=/path/to/obsidian/vault
DISPATCH_VAULT_PATH=/path/to/dispatch/vault

# Alt-text generation provider (scripts/meta/generate-alt-text.mjs)
ALT_TEXT_PROVIDER=

# Origin used when printing absolute URLs from CLI tools — the capability links
# from `yarn seal` / `yarn seal:links`. Defaults to https://ejfox.com.
SITE_ORIGIN=https://ejfox.com

# Screenshot capture (yarn capture). CHROME_BIN overrides Chrome's location;
# CAPTURE_PORT the local port it drives.
CHROME_BIN=
CAPTURE_PORT=

# Output path override for scripts/meta/gen-gear-annex.mjs
GEAR_ANNEX_OUT=

# Public Variables (exposed to client)
NUXT_PUBLIC_BASE_URL=https://ejfox.com