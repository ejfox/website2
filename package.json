{
  "name": "website2",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/build/generate-changelog.mjs && node scripts/build/copy-blogroll.mjs && { [ -n \"$CI\" ] || { (node scripts/build/export-github-repos.mjs || echo 'GitHub export failed, using cached data') && (node scripts/build/export-github-networks.mjs || echo 'Network export failed, using cached data'); }; } && (node scripts/build/fetch-goodreads.mjs || echo 'Goodreads fetch failed, using cached data')",
    "build": "nuxt build",
    "github:export": "node scripts/build/export-github-repos.mjs",
    "github:networks": "node scripts/build/export-github-networks.mjs",
    "goodreads:fetch": "node scripts/build/fetch-goodreads.mjs",
    "lint": "eslint .",
    "check:components": "node scripts/meta/check-component-tags.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "atlas:fetch": "node scripts/build/fetch-atlas-places.mjs",
    "atlas:basemap": "bash scripts/build/atlas-basemap.sh",
    "blog:process": "DEBUG=true node scripts/build/processMarkdown.mjs",
    "blog:mirror-atproto": "node scripts/author/mirror-to-atproto.mjs",
    "blog:check-links": "CHECK_LINKS=true DEBUG=true node scripts/build/processMarkdown.mjs",
    "blog:dead-links": "node scripts/meta/check-internal-links.mjs",
    "blog:fix-links": "CHECK_LINKS=true AUTO_FIX_LINKS=true DEBUG=true node scripts/build/processMarkdown.mjs",
    "blog": "npm run lint:safety && npm run blog:process && npm run check:sealed",
    "create-prediction": "node scripts/blog/create-prediction.mjs",
    "predict": "node scripts/author/predict-pro.mjs",
    "calibrate": "node --no-warnings scripts/meta/calibration-analysis.mjs",
    "gear:lint": "node scripts/meta/lint-gear.mjs",
    "gear:fix": "node scripts/meta/lint-gear.mjs --fix",
    "lint:safety": "node scripts/meta/lint-frontmatter-safety.mjs",
    "webmention": "node scripts/author/send-webmentions.mjs",
    "webmention:dry": "node scripts/author/send-webmentions.mjs --dry",
    "webmention:all": "node scripts/author/send-webmentions.mjs --all",
    "crown": "node scripts/author/crown.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && (git config core.hooksPath .githooks || true)",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node .output/server/index.mjs",
    "clean": "rm -rf .nuxt dist .output node_modules/.cache",
    "build:prod": "NITRO_PRESET=node-server yarn build",
    "resume:build": "node scripts/resume/build-resume.mjs",
    "deploy": "git push origin main && sleep 8 && gh run watch --exit-status $(gh run list --workflow deploy.yml --commit $(git rev-parse HEAD) --limit 1 --json databaseId -q '.[0].databaseId')",
    "capture": "node scripts/capture.mjs",
    "shoot": "node scripts/author/shoot-queue.mjs",
    "rides:process": "node scripts/build/process-rides.mjs",
    "check:sealed": "node scripts/meta/check-sealed.mjs",
    "smoke": "node scripts/meta/smoke-prod.mjs --browser",
    "check:urls": "node scripts/meta/check-urls.mjs --base origin/main",
    "check:urls:seed": "node scripts/meta/seed-published-urls.mjs",
    "check:images": "node scripts/meta/check-image-pii.mjs",
    "icons:vendor": "node scripts/build/vendor-link-icons.mjs",
    "images:sync-ocr": "node scripts/meta/sync-ocr-to-cloudinary.mjs",
    "images:unify": "node scripts/meta/unify-cloudinary-text.mjs",
    "seal:links": "node scripts/author/seal-links.mjs",
    "seal:import": "node scripts/blog/import-sealed.mjs",
    "seal": "npm run seal:import && npm run blog:process && npm run check:sealed",
    "meta:frontmatter-sync": "node scripts/meta/frontmatter-sync-report.mjs",
    "qa:layout": "node scripts/qa/layout-review.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@rehype-pretty/transformers": "^0.13.2",
    "@tailwindcss/typography": "^0.5.16",
    "@turf/bbox-clip": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "@types/d3": "^7.4.3",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/rss": "^0.0.32",
    "@types/sanitize-html": "^2.13.0",
    "@types/three": "^0.186.0",
    "consola": "^3.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.6.2",
    "playwright": "^1.64.0",
    "prettier": "^3.6.2",
    "rehype-pretty-code": "^0.14.0",
    "rehype-stringify": "^10.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^4.5.0",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@nuxtjs/tailwindcss": "^6.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "@supabase/supabase-js": "^2.87.1",
    "@vueuse/core": "^15.0.0",
    "animejs": "^4.2.2",
    "chalk": "^6.0.1",
    "chroma-js": "^3.2.0",
    "cloudinary": "^2.9.0",
    "d3": "^7.9.0",
    "d3-dsv": "^3.0.1",
    "d3-format": "3",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.3.7",
    "floating-vue": "^5.2.2",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "h3": "^1.13.0",
    "inquirer": "^14.0.2",
    "jszip": "^3.10.2",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.11.2",
    "mdast-util-to-string": "^4.0.0",
    "node-cache": "^5.1.2",
    "ora": "^9.0.0",
    "pele": "^1.6.0",
    "pg": "^8.21.0",
    "pmtiles": "^4.5.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "remark-stringify": "^11.0.0",
    "rss": "^1.2.2",
    "sanitize-html": "^2.17.0",
    "simplex-noise": "^4.0.3",
    "striptags": "^3.2.0",
    "three": "^0.186.1",
    "unist-util-visit": "^5.0.0",
    "vue": "^3.5.13"
  },
  "license": "UNLICENSED"
}
