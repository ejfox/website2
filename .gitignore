# Nuxt dev/build outputs
.output
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules
# Prevent accidental node_modules in content directories
content/**/node_modules
content/processed/**/node_modules

# Logs & build artifacts
logs
*.log
lighthouse*.json
lighthouse*.html
test-*.html
page.html
headers.txt
deps-to-move.txt

# Misc
.DS_Store
.fleet
.idea
.vscode

# Local env files
.env
.env.*
!.env.example

# Generated content
# content/backup/**/*
content/processed.backup/**/*
*.backup
# Sentry Config File
.env.sentry-build-plugin
content/backup/**
content/backup/**/*
content/backup/drafts/_stale/*
.aider*

.cursor/*
.claude/settings.local.json
.build-info.json

# Local-only content report viewer
data/content-report.html
data/content-report.json
data/og-previews/

# Build-time generated by scripts/build/generate-changelog.mjs and scripts/build/copy-blogroll.mjs
data/changelog.json
data/blogroll.urls
.runtime-cache/

# Cloned tool used by export-github-networks.mjs
data/_tool-cache/

# Gear sync transient backups. Two naming conventions in the wild —
# `gear.csv.backup.<ts>` and `gear.csv.bak-<tag>` — and only the first was
# ignored, so seven of the latter got committed by a too-broad `git add data/`.
data/gear.csv.backup.*
data/gear.csv.bak-*

# This is a yarn project — no npm lockfile
package-lock.json

# Screenshot review scratch (capture/shoot workflow) — local only
data/capture-review/

# Dead artifact — removed 2026-07 (nothing reads it; API uses on-this-day/ dir)
data/on-this-day-index.json

# Cal.com webhook funnel log (runtime data)
data/calcom-events.jsonl

# raw GPX tracks stay local — only privacy-trimmed processed JSON is committed
content/rides/**/*.gpx

# Feed/API disk caches — regenerated at runtime, can be large
data/cache/

# ── Sealed posts ──────────────────────────────────────────────────────────
# Plaintext source for password/link-protected posts. This repo is PUBLIC, so
# this is the wall: `git add -A` cannot stage an ignored file, which makes
# "the source never enters the repo" true by construction rather than by
# remembering. The vault is the real source of truth; what gets committed is
# content/processed/private/*.json, which is an opaque AES-256-GCM envelope.
content/blog/private/

# The 256-bit key for every sealed post, one per slug. The ONLY copy besides
# the links already shared — not in GitHub Actions, not on the VPS, not here.
# Back it up to 1Password. See scripts/build/sealKeyring.mjs.
.postkeys.json

# Timestamped vault backups written by scripts/meta/vault-repo-merge.mjs --apply
.vault-backup-*/
